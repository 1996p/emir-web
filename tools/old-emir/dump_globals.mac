set dir="/tmp/sverka/" do ##class(%File).CreateDirectoryChain(dir)
set list="Contract.ContractD,Contract.History.TarifD,Contract.History.StateD,Contract.Tarif.TarifD,Contract.Tarif.ServiceD,GKH.ContracA908.AbstractSchemeD,GKH.Housing.ApartmentD,GKH.Housing.HouseD,GKH.Housing.HouseCategoryD,GKH.User.AbonentD,GKH.User.ResidentD,GKH.Krsk.ContractNormD,AccountD,AbonentD,HumanD,OrganizationD,Reference.AccountProviderD,Reference.ContractStateD,BookKeeping.Docs.BillRecordD,BookKeeping.Docs.AccountRestD,GKH.Hard.ReadingD,GKH.Hard.MeterD,GKH.Hard.LinkD,Reference.UnitD,Address.PAddressD,Address.PHouseD,Address.PStreetD,Address.PCityD"
for i=1:1:$length(list,",") { set gn=$piece(list,",",i),g="^"_gn set f=##class(%Stream.FileCharacter).%New() set f.TranslateTable="UTF8" do f.LinkToFile(dir_gn_".jsonl") set id="",n=0 for { set id=$order(@g@(id)) quit:id=""  set o={"id":(id)} if $data(@g@(id))#2 { set o.v=##class(%DynamicArray).%New() set v=@g@(id) if $listvalid(v) { for j=1:1:$listlength(v) { set x=$listget(v,j) do o.v.%Push($select($listvalid(x)&&(x'=""):"L:"_$listtostring(x,",",1),1:x)) } } else { do o.v.%Push(v) } } set s="",sub={} for { set s=$order(@g@(id,s)) quit:s=""  if $data(@g@(id,s))#2 { set v=@g@(id,s) set a=[] if $listvalid(v) { for j=1:1:$listlength(v) { set x=$listget(v,j) do a.%Push($select($listvalid(x)&&(x'=""):"L:"_$listtostring(x,",",1),1:x)) } } else { do a.%Push(v) } do sub.%Set(s,a) } else { set k="",b={} for { set k=$order(@g@(id,s,k)) quit:k=""  set vv=$get(@g@(id,s,k)) do b.%Set(k,$select($listvalid(vv)&&(vv'=""):"L:"_$listtostring(vv,",",1),1:vv)) } do sub.%Set(s,b) } } if sub.%Size() { set o.sub=sub } do f.WriteLine(o.%ToJSON()) set n=n+1 } do f.%Save() write "D ",gn," ",n,! }
halt
